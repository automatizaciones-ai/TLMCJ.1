# Configuración del Entorno - Consola TLM Enterprise
# IMPORTANTE: No colocar contraseñas ni secretos reales en este archivo de ejemplo.

PORT=3000
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL / Google Cloud SQL / Neon
# Formato: postgresql://<USUARIO>:<PASSWORD>@<HOST>:<PUERTO>/<DATABASE>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_DB_PASSWORD@ep-rough-term-b4jl3vvr-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Integración Siigo Nube API
SIIGO_API_URL=https://api.siigo.com/v1
SIIGO_PARTNER_ID=TLM_ENTERPRISE_BIC

# Configuración de Sesión y Token JWT
JWT_SECRET=your_jwt_secret_token_here
SESSION_TIMEOUT_HOURS=8

# ==========================================================
# Almacenamiento contable por empresa (carpetas / unidades compartidas)
# Sin credenciales de Google se usa almacenamiento local en el servidor.
# ==========================================================
# Carpeta base del almacenamiento local (por defecto ./storage/empresas)
TLM_STORAGE_DIR=

# Opción A (recomendada): cuenta de servicio de Google Cloud con la API de Drive habilitada.
# Pegue el JSON completo (o en base64). Comparta cada carpeta / unidad compartida con el correo
# de la cuenta de servicio (Editor / Administrador de contenido).
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...o la ruta al archivo JSON
GOOGLE_APPLICATION_CREDENTIALS=
# (Opcional, Google Workspace) usuario a suplantar con delegación de dominio para escribir en "Mi unidad"
GOOGLE_DRIVE_IMPERSONATE=

# Opción B: OAuth de una cuenta de Google (sirve con Gmail personal)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCOUNT_EMAIL=

# ==========================================
# Notificaciones por correo (Admin Usuarios & Cloud → Notificaciones (Correo))
# ==========================================
# Proveedor: GMAIL_API | RESEND | SMTP | SIMULADO. Si se deja vacío se detecta por las variables definidas.
# Importante: el plan gratuito de Render bloquea los puertos SMTP (25/465/587); use GMAIL_API o RESEND.
CORREO_PROVEEDOR=
# Buzón que envía los correos (en Gmail API debe ser un usuario real del dominio de Google Workspace)
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=Consola TLM
# Enlace del botón "Abrir la Consola TLM" en los correos
APP_URL=

# Opción 1: Gmail API con la cuenta de servicio (GOOGLE_SERVICE_ACCOUNT_JSON de arriba) + delegación de dominio
#   En admin.google.com → Seguridad → Controles de API → Delegación de todo el dominio, autorice el Client ID de la
#   cuenta de servicio con el permiso https://www.googleapis.com/auth/gmail.send
# ...o con OAuth de la cuenta que envía (el refresh token debe incluir el permiso gmail.send):
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Opción 2: Resend (https://resend.com), con CORREO_REMITENTE de un dominio verificado
RESEND_API_KEY=

# Opción 3: SMTP (Google Workspace: smtp.gmail.com:587 con contraseña de aplicación; Microsoft 365: smtp.office365.com:587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
